# Real secrets -- never commit this. Copy .env.example instead.
.env

# Virtual environment
.venv/
venv/

# Python
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# The database itself: a local SQLite file that grows over time and
# has no business in git history. data/source_files/ is deliberately
# NOT excluded -- reference exports like the Automechanika workbook
# belong in the repo, only the live database doesn't.
data/*.db
data/*.db.bak
data/*.db-journal
data/*.db-wal
data/exports/*
data/collection/*

# Logs
logs/*.log
*.bak
data/*.db*

# Local enrichment pipeline outputs/scripts (geocoding, Street View,
# reverse-image-search) -- same reasoning as data/collection and
# data/exports above: real data files and one-off local-run artifacts,
# not codebase. Left in place, just untracked.
RUN_THIS_GUIDE.md
diagnose_streetview.py
enrich_factories.py
extract_and_verify.py
injection_moulding_100_enriched.xlsx
output/
photos/
